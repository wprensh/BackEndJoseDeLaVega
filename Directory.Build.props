<Project>
  <!-- Configuración compartida por todos los proyectos de la solución. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CS1591: comentarios XML en miembros públicos (no obligatorio en todo el código). -->
    <NoWarn>$(NoWarn);CS1591;CA1515;CA1848;CA1716;CA1062;CA1711;CA2007</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
